{
  "name": "office-templates-hub",
  "version": "0.1.0",
  "description": "AI-ready search and secure delivery service for workplace templates and workflow assets.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx backend/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint backend/src backend/tests",
    "scan:public": "tsx scripts/public-repo-scan.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:prod && pnpm scan:public",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/backend/src/server.js",
    "smoke:prod": "tsx scripts/production-smoke.ts"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "fastify": "5.12.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
