{
  "name": "office-templates-hub",
  "version": "0.1.0",
  "description": "AI-ready search and secure delivery service for workplace templates and workflow assets.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx backend/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint backend/src backend/tests",
    "scan:public": "tsx scripts/public-repo-scan.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:prod && pnpm scan:public",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/backend/src/server.js",
    "smoke:prod": "tsx scripts/production-smoke.ts",
    "skill:resolve": "tsx backend/src/skill-cli.ts",
    "standards:build": "tsx scripts/build-asset-standards.ts",
    "standards:scan": "tsx scripts/scan-standard-evolution.ts",
    "standards:verify-active": "tsx scripts/check-active-standard.ts",
    "standards:promote": "tsx scripts/promote-standard-snapshot.ts",
    "standards:rollback": "tsx scripts/rollback-standard-snapshot.ts",
    "standards:docs:sync": "tsx scripts/sync-standard-document.ts --mode sync",
    "standards:docs:check": "tsx scripts/sync-standard-document.ts --mode check"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "3.18.3",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "exceljs": "^4.4.0",
    "fastify": "5.12.4",
    "pg": "^8.23.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/pg": "^8.23.1",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
