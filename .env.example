# Runtime network binding. Cloud platforms usually inject PORT; local default is 8787.
HOST=127.0.0.1
PORT=8787

# Server-side peppers. Generate long random values and store them only in local/platform secrets.
DEVICE_SECRET_PEPPER=replace-with-random-device-pepper
CODE_SECRET_PEPPER=replace-with-random-code-pepper
RECOVERY_SECRET_PEPPER=replace-with-random-recovery-pepper

# Optional CloudBase runtime database. Leave empty for local in-memory mode.
CLOUDBASE_ENV_ID=

# Optional COS signing config. Leave all COS_* empty for local degraded mode;
# if any COS core variable is set, all COS_SECRET_ID/COS_SECRET_KEY/COS_BUCKET/COS_REGION are required.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_OBJECT_PREFIX=templates/
COS_SIGN_EXPIRES_SECONDS=300
